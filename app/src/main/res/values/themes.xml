<resources>
    <style name="Theme.Ime9" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/setup_bg</item>
        <item name="android:navigationBarColor">@color/setup_bg</item>
        <item name="android:windowBackground">@color/setup_bg</item>
        <item name="android:textColor">@color/setup_text</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="Theme.Ime9.InputMethod" parent="@android:style/Theme.DeviceDefault.InputMethod">
        <item name="android:navigationBarColor">@color/ime_bg</item>
        <item name="android:windowBackground">@color/ime_bg</item>
        <item name="android:colorBackground">@color/ime_bg</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
